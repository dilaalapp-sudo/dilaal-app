# ── DILAAL Admin Panel — browser-safe environment only ──
# BOTH keys come from the SAME Supabase project as the marketplace:
#   Supabase Dashboard → Project Settings → API Keys
# Only the ANON (publishable) key belongs here — it is safe to ship to the
# browser. The service_role key must NEVER appear in this app: privileged
# operations go through the Express API (dilaal-main) which authorizes every
# /api/admin/* call server-side using the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: absolute origin of the DILAAL API (e.g. http://localhost:3000 or
# https://api.dilaal.example). Leave empty in development — the Vite dev
# server proxies /api/* to http://localhost:3000 (see vite.config.ts).
VITE_API_BASE_URL=
