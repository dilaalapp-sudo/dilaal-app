# Supabase configuration (frontend)
# Get these from: Supabase Dashboard -> Project Settings -> API
# Prefix with VITE_ so Vite exposes them to the browser bundle.
# NOTE: only the ANON key belongs here. The SERVICE_ROLE key bypasses all RLS
# and must never be shipped to the browser — keep it in a backend/CI secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Required by POST /api/auth/register (auto-confirmed accounts)
# and every /api/admin/* route (role verification, privileged reads/writes).
# NEVER expose this key to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Escrow mode: sandbox_pilot (default) or live
ESCROW_MODE=sandbox_pilot

# Google Gemini API key (for AI features, optional)
GEMINI_API_KEY=

# Web Push VAPID public key (optional — enables browser push notifications)
# Generate with: npx @vitejs/plugin-react or use a VAPID key generator
# Set VITE_VAPID_PUBLIC_KEY only on the client; the private key stays on your push server.
VITE_VAPID_PUBLIC_KEY=
